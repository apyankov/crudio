# Использование базового образа с JDK 17
FROM maven:3.9-eclipse-temurin-21 AS builder

# Установка рабочей директории
WORKDIR /app

# Копирование файла pom.xml
COPY pom.xml .

# Копирование исходного кода
COPY crudio-common ./crudio-common
COPY crudio-backend ./crudio-backend
COPY crudio-api ./crudio-api

# Загрузка зависимостей
RUN mvn dependency:go-offline

# Сборка приложения
RUN mvn clean compile package

# Использование более легкого базового образа для финального образа
FROM openjdk:21-jdk-slim

# Установка рабочей директории
WORKDIR /app

# Копирование JAR-файла из предыдущего шага
COPY --from=builder /app/crudio-api/target/default/crudio-api.jar crudio-api.jar

# Запуск приложения
ENTRYPOINT ["java", "-jar", "crudio-api.jar"]
